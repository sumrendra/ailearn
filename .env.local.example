# ─────────────────────────────────────────────────
# AILearn Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────────

# Database (auto-configured when using Docker Compose)
DATABASE_URL="postgresql://ailearn:ailearn_password@localhost:5432/ailearn"

# Anthropic (required for AI tutor, quiz gen, mock interviews)
# ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini (AI tutor, TCF content generation — not used for listening TTS)
GEMINI_API_KEY="AIzaSy..."

# TCF listening audio files on volume (production: /data/audio)
# AUDIO_ROOT="/data/audio"

# NextAuth (required for auth, generate a secret: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"

# OAuth providers (optional — add when you want login)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
