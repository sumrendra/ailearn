generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / users ─────────────────────────────────────────────────────────
//
// All static educational content (paths, lessons, flashcards, quizzes,
// achievements, daily challenges) lives in code under src/lib/content/.
// The database is intentionally scoped to user-specific data only.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  xp              Int      @default(0)
  level           Int      @default(1)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  DateTime?
  streakFreezes   Int      @default(2)

  accounts          Account[]
  sessions          Session[]
  progress          LessonProgress[]
  flashcardReviews  FlashcardReview[]
  quizAttempts      QuizAttempt[]
  notes             Note[]
  achievements      UserAchievement[]
  interviewSessions InterviewSession[]
  chatSessions      ChatSession[]
  tcfProfile        TcfProfile?
  tcfUnitProgress   TcfUnitProgress[]
  tcfGrammarMastery TcfGrammarMastery[]
  tcfAttempts       TcfAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User-specific progress / activity ────────────────────────────────────
//
// These reference content (lessons, flashcards, etc.) by their stable string
// slugs/keys — content lives in code, so no FK to a `Lesson` table.

model LessonProgress {
  id            String         @id @default(cuid())
  userId        String
  lessonSlug    String
  status        ProgressStatus @default(NOT_STARTED)
  completedAt   DateTime?
  timeSpentMins Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([lessonSlug])
}

model FlashcardReview {
  id         String   @id @default(cuid())
  userId     String
  /// Stable key from src/lib/content/flashcards.ts (typically "lessonSlug:n")
  cardKey    String
  rating     Int
  nextReview DateTime
  interval   Int      @default(1)
  easeFactor Float    @default(2.5)
  reviewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReview])
  @@index([cardKey])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonSlug  String?
  score       Int
  totalQs     Int
  xpEarned    Int      @default(0)
  completedAt DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizAttemptQuestion[]
}

model QuizAttemptQuestion {
  id          String  @id @default(cuid())
  attemptId   String
  /// Stable key from src/lib/content/quizzes.ts (typically "lessonSlug:qN")
  questionKey String
  userAnswer  String  @db.Text
  isCorrect   Boolean
  timeTakenMs Int     @default(0)

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  lessonSlug String?
  title      String
  content    String   @db.Text
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonSlug])
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementSlug String
  unlockedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementSlug])
}

model InterviewSession {
  id           String     @id @default(cuid())
  userId       String
  topic        String
  difficulty   Difficulty
  messages     Json
  overallScore Int?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id         String   @id @default(cuid())
  userId     String
  lessonSlug String?
  messages   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// TCF listening audio metadata — MP3 files on AUDIO_ROOT volume (not in DB or app bundle).
/// Populated via `npm run upload:tcf-audio:server`.
model AudioAsset {
  id            String   @id @default(cuid())
  namespace     String
  paper         Int
  questionIndex Int
  contentHash   String
  storagePath   String
  mimeType      String   @default("audio/mpeg")
  voice         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([namespace, paper, questionIndex])
  @@index([namespace, paper])
}

// ─── TCF Canada Program (user progress) ───────────────────────────────────

model TcfProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  targetNclc     Int       @default(7)
  placementCefr  String    @default("A0")
  weeklyHours    Int       @default(6)
  examDate       DateTime?
  onboardingDone Boolean   @default(false)
  roadmapPrefs   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TcfUnitProgress {
  id            String         @id @default(cuid())
  userId        String
  unitSlug      String
  status        ProgressStatus @default(NOT_STARTED)
  completedAt   DateTime?
  timeSpentMins Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, unitSlug])
  @@index([unitSlug])
}

model TcfGrammarMastery {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  state     String   @default("available")
  lastScore Int?
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model TcfAttempt {
  id          String   @id @default(cuid())
  userId      String
  module      String
  paper       Int?
  scoreRaw    Float?
  scoreNclc   Int?
  score699    Int?
  durationSec Int      @default(0)
  detailJson  Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, module])
  @@index([userId, createdAt])
}
