generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  xp              Int      @default(0)
  level           Int      @default(1)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  DateTime?
  streakFreezes   Int      @default(2)

  accounts         Account[]
  sessions         Session[]
  progress         LessonProgress[]
  flashcardReviews FlashcardReview[]
  quizAttempts     QuizAttempt[]
  notes            Note[]
  achievements     UserAchievement[]
  interviewSessions InterviewSession[]
  chatSessions     ChatSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LearningPath {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String
  icon           String
  color          String
  difficulty     Difficulty
  estimatedHours Int
  tags           String[]
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  lessons Lesson[]
}

model Lesson {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  content       String   @db.Text
  pathId        String
  order         Int
  estimatedMins Int      @default(15)
  xpReward      Int      @default(50)
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  path          LearningPath     @relation(fields: [pathId], references: [id])
  progress      LessonProgress[]
  flashcards    Flashcard[]
  quizQuestions QuizQuestion[]
  notes         Note[]
}

model LessonProgress {
  id            String         @id @default(cuid())
  userId        String
  lessonId      String
  status        ProgressStatus @default(NOT_STARTED)
  completedAt   DateTime?
  timeSpentMins Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Flashcard {
  id        String   @id @default(cuid())
  lessonId  String?
  front     String   @db.Text
  back      String   @db.Text
  tags      String[]
  createdAt DateTime @default(now())

  lesson  Lesson?           @relation(fields: [lessonId], references: [id])
  reviews FlashcardReview[]
}

model FlashcardReview {
  id         String   @id @default(cuid())
  userId     String
  cardId     String
  rating     Int
  nextReview DateTime
  interval   Int      @default(1)
  easeFactor Float    @default(2.5)
  reviewedAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id            String       @id @default(cuid())
  lessonId      String?
  type          QuestionType
  question      String       @db.Text
  options       Json?
  correctAnswer String?      @db.Text
  explanation   String       @db.Text
  difficulty    Difficulty
  tags          String[]
  createdAt     DateTime     @default(now())

  lesson   Lesson?               @relation(fields: [lessonId], references: [id])
  attempts QuizAttemptQuestion[]
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String?
  score       Int
  totalQs     Int
  xpEarned    Int      @default(0)
  completedAt DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizAttemptQuestion[]
}

model QuizAttemptQuestion {
  id          String  @id @default(cuid())
  attemptId   String
  questionId  String
  userAnswer  String  @db.Text
  isCorrect   Boolean
  timeTakenMs Int     @default(0)

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  title     String
  content   String   @db.Text
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id])
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  icon        String
  xpReward    Int    @default(100)
  rarity      Rarity @default(COMMON)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model InterviewSession {
  id           String     @id @default(cuid())
  userId       String
  topic        String
  difficulty   Difficulty
  messages     Json
  overallScore Int?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyChallenge {
  id       String        @id @default(cuid())
  date     DateTime      @unique @db.Date
  type     ChallengeType
  title    String
  content  String        @db.Text
  xpReward Int           @default(25)
  tags     String[]
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  CODE_REVIEW
  SCENARIO
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum ChallengeType {
  CONCEPT
  PAPER
  CODE_SNIPPET
  SCENARIO
  TOOL_SPOTLIGHT
}
